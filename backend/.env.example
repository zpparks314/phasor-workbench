# Local development example. All variables are optional; see config.py.
# Render uses service environment variables instead. See docs/Deployment.md.

# Origins permitted to call the API in development.
QW_CORS_ORIGINS=["http://localhost:5173"]

# Production value (set on Render, not required for local development):
# QW_CORS_ORIGINS=["https://phasor.zacharyparks.site"]
# Use a JSON array of exact origins, without trailing slashes. Never use "*"
# for the production allowlist. The existing QW_ prefix is intentional.

# Enforced configurable limits. /api/v1/capabilities is not implemented yet.
QW_MAX_SHOTS=100000
QW_MAX_STATEVECTOR_QUBITS=12
QW_MAX_QASM_CHARACTERS=256000

# Reserved settings, currently NOT enforced by the request path. The Qiskit
# adapter separately enforces a fixed 20-qubit cap. See docs/Simulation.md.
QW_MAX_QUBITS=20
QW_MAX_OPERATIONS=10000
QW_SIMULATION_TIMEOUT_SECONDS=30
