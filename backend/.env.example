# All variables are optional; defaults are defined in config.py.

# Origins permitted to call the API in development.
QW_CORS_ORIGINS=["http://localhost:5173"]

# Resource limits, advertised through /api/v1/capabilities.
# See docs/Simulation.md for why the qubit cap is what it is.
QW_MAX_QUBITS=20
QW_MAX_OPERATIONS=10000
QW_MAX_SHOTS=100000
QW_SIMULATION_TIMEOUT_SECONDS=30
