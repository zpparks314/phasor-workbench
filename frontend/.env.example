# Local development example. See docs/Deployment.md for production configuration.
# Base origin for the backend API (do not include /api/v1).
# Left empty in development so requests go through the Vite dev proxy
# (see vite.config.ts) and share the browser's origin.
VITE_API_BASE_URL=

# For GitHub Pages, set the repository variable VITE_API_BASE_URL to the real
# HTTPS Render origin once the service exists. Vite embeds it at build time;
# changing it requires another build/deployment. VITE_* values are public.

# When true, the API client returns recorded mock responses instead of
# calling the backend. Architecture.md requires the frontend to remain
# functional when the simulation backend is unavailable.
VITE_USE_MOCK_API=false
